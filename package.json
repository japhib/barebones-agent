{
  "name": "barebones-agent",
  "version": "0.1.0",
  "description": "A barebones coding agent: one turn per invocation, transcript as the UI.",
  "type": "module",
  "bin": { "bba": "dist/agent.js" },
  "engines": { "node": ">=20.10.0" },
  "scripts": {
    "build": "esbuild src/agent.ts --bundle --platform=node --target=node20 --format=esm --packages=bundle --sourcemap --outfile=dist/agent.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/*.test.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outdir=dist/tests && node --test dist/tests/*.test.js",
    "dev": "npm run build -- --watch"
  },
  "dependencies": {
    "@node-llm/core": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
